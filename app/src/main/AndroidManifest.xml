<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Only used while Jakob made Orbit the phone app: the call screen over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Screen off at the ear during a call (proximity sensor). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- PLAN 9 A1: Orbit's own account in the address book (asked when Jakob turns it on). -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <!-- PLAN 9 A13: Orbit's own calendar with the occasions (asked when Jakob turns it on). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Haptik-Vokabular (PLAN 9.2): „Materialisieren“ is a composed vibration. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- „Gratulieren“ opens WhatsApp only if it is installed (else SMS): Orbit must be allowed to see it. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.android.chrome" />
        <!-- Portale (PLAN 3.7) open in a Custom Tab of the phone's browser. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".OrbitApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Orbit"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Teilen-Eingang (PLAN 3.8): places from Maps, pages, text, pictures. -->
            <intent-filter android:label="Orbit">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Orbit">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- PLAN 9 A5: people as direct share targets. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- PLAN 9 A2: „Kontakt hinzufügen“ from any app, vCard files and scanned vCard QRs. -->
        <activity
            android:name=".actions.ContactIntakeActivity"
            android:exported="true"
            android:label="Orbit"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Orbit.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/person" />
                <data android:mimeType="vnd.android.cursor.dir/raw_contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT_OR_EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/directory" />
            </intent-filter>
        </activity>

        <!-- PLAN 9 A4: „Orbit“ in the text-selection menu of every app. -->
        <activity
            android:name=".actions.ProcessTextActivity"
            android:exported="true"
            android:label="Orbit"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Orbit.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- PLAN 9 A1: the account „Orbit“ and its (empty) sync adapter for the address book. -->
        <service
            android:name=".phonebook.OrbitAuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <service
            android:name=".phonebook.OrbitSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/sync_contacts" />
            <meta-data
                android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/contacts" />
        </service>

        <!-- PLAN 9 A13: calendar apps list an account's calendars with a sync adapter too. -->
        <service
            android:name=".phonebook.OrbitCalendarSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/sync_calendar" />
        </service>

        <!-- PLAN 9 A3: „In Orbit öffnen“ / own-field rows in a system contact card. -->
        <activity
            android:name=".phonebook.PhoneBookRowActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Orbit.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/vnd.io.github.thelony97.orbit.profile" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/vnd.io.github.thelony97.orbit.field" />
            </intent-filter>
        </activity>

        <!-- PLAN 9 A6: „Orbit“ in every file picker – a folder per person, read only. -->
        <provider
            android:name=".files.OrbitDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Shares a contact as .vcf from cache/share only (PLAN 3.3). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!--
            Orbit als Telefon-App (PLAN 3.12). Service and dial screen are DISABLED here and only
            enabled by the switch in Einstellungen › Mitschreiben (call/PhoneRole.kt), so nothing
            changes on the phone until Jakob turns it on. The system keeps ringing.
        -->
        <service
            android:name=".call.OrbitInCallService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="false" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <activity
            android:name=".call.DialerActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity="io.github.thelony97.orbit.dial"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <activity
            android:name=".call.CallActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="io.github.thelony97.orbit.call" />

        <receiver
            android:name=".call.CallActionReceiver"
            android:exported="false" />

        <activity
            android:name=".notify.CongratulateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Orbit.Invisible" />

        <activity
            android:name=".notify.CallActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Orbit.Invisible" />

        <receiver
            android:name=".sync.PhoneStateReceiver"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notify.DigestReceiver"
            android:exported="false" />

        <receiver
            android:name=".notify.NotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.OrbitWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/orbit_widget_info" />
        </receiver>

        <!-- Angepinnte Links (PLAN 3.7). -->
        <receiver
            android:name=".widget.LinksWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_links_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/links_widget_info" />
        </receiver>

        <!-- Favoriten (PLAN 3.14). -->
        <receiver
            android:name=".widget.FavoritesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_favorites_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/favorites_widget_info" />
        </receiver>

        <!-- Nummern-Schublade (PLAN 9 A9): Jakob's numbers over any app. -->
        <service
            android:name=".notify.NumbersTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_numbers"
            android:label="@string/tile_numbers"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".notify.NumbersActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="io.github.thelony97.orbit.numbers"
            android:theme="@style/Theme.Orbit.Invisible" />

        <!-- Schnelleinstellungs-Kachel „Notiz zum letzten Anruf“ (PLAN 3.14). -->
        <service
            android:name=".notify.LastCallTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_note"
            android:label="@string/tile_last_call"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
