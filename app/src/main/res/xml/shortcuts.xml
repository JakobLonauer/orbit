<?xml version="1.0" encoding="utf-8"?>
<!-- PLAN 9 A5: people as direct share targets (dynamic shortcuts with this category). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="io.github.thelony97.orbit.MainActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="application/pdf" />
        <category android:name="io.github.thelony97.orbit.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
