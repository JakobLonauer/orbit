<?xml version="1.0" encoding="utf-8"?>
<!-- PLAN 9 A3: Orbit rows in every system contact card – „In Orbit öffnen“ and own fields. -->
<ContactsAccountType xmlns:android="http://schemas.android.com/apk/res/android">
    <ContactsDataKind
        android:mimeType="vnd.android.cursor.item/vnd.io.github.thelony97.orbit.profile"
        android:icon="@mipmap/ic_launcher"
        android:summaryColumn="data2"
        android:detailColumn="data3" />
    <ContactsDataKind
        android:mimeType="vnd.android.cursor.item/vnd.io.github.thelony97.orbit.field"
        android:icon="@mipmap/ic_launcher"
        android:summaryColumn="data2"
        android:detailColumn="data3" />
    <!-- PLAN 9 A3/B4: „Makro wählen“ for organisations with a Hotline-Makro. -->
    <ContactsDataKind
        android:mimeType="vnd.android.cursor.item/vnd.io.github.thelony97.orbit.macro"
        android:icon="@mipmap/ic_launcher"
        android:summaryColumn="data2"
        android:detailColumn="data3" />
</ContactsAccountType>
